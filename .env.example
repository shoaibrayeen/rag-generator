# ============================================================
# RAG Generator configuration. Copy to `.env` and edit.
# Only the three LLM_* lines are required to get answers.
# Every other value is optional and shown with its default.
# ============================================================

# --- Generation LLM: any OpenAI-compatible chat/completions endpoint ---
# Examples: https://api.openai.com/v1 | https://openrouter.ai/api/v1 |
#           https://api.groq.com/openai/v1 | http://host.docker.internal:11434/v1 (Ollama)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
#LLM_TEMPERATURE=0.1
#LLM_MAX_TOKENS=1024
#LLM_TIMEOUT_S=60

# --- Evaluation judge (Claude). Only needed for `python -m evaluation.run_eval` ---
ANTHROPIC_API_KEY=
#JUDGE_MODEL=claude-opus-5
#JUDGE_MAX_TOKENS=4096
#EVAL_MIN_FAITHFULNESS=3.5

# --- Embeddings (fastembed) ---
#EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#EMBEDDING_BATCH_SIZE=64

# --- Chunking ---
#CHUNK_SIZE_CHARS=1200
#CHUNK_OVERLAP_CHARS=200
#CSV_ROWS_PER_PAGE=50

# --- OCR fallback (Tesseract) ---
#OCR_ENABLED=true
#OCR_MIN_CHARS_PER_PAGE=20
#OCR_LANG=eng
#OCR_DPI=200

# --- Retrieval: dense top-k + BM25 top-k fused with Reciprocal Rank Fusion ---
#DENSE_TOP_K=20
#BM25_TOP_K=20
#FUSED_TOP_K=6
#RRF_K=60

# --- Storage / server ---
#DATA_DIR=data
#DEFAULT_COLLECTION=default
#MAX_UPLOAD_MB=50
#APP_HOST=0.0.0.0
#APP_PORT=8000

# --- CLI / eval target ---
#RAG_API_URL=http://localhost:8000
